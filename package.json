{
  "name": "field-station",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/.bin/vite dev --port 3456",
    "build": "node ./node_modules/.bin/vite build",
    "preview": "node ./node_modules/.bin/vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
